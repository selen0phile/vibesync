# Copy to `.env` in the project root. Do not commit `.env`.

PORT=3847
PUBLIC_APP_ORIGIN=http://localhost:5173

# Optional — signing secrets (change in production):
# ADMIN_SECRET=change-me-to-a-long-random-string
# JWT_SECRET=change-me-app-jwt-secret
# STREAM_SIGNING_SECRET=

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibesync
# DB_USER=postgres
# DB_PASS=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=vibesync

# --- MinIO / S3 (user library uploads) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_INTERNAL_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vibesync
# Browser uploads/downloads must use a public HTTPS host (not localhost):
MINIO_PUBLIC_URL=https://minio.example.com
# S3_* aliases also supported (S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY, S3_BUCKET)
S3_PRESIGN_PUT_TTL_SEC=600
S3_PRESIGN_GET_TTL_SEC=3600

# Per-user uploaded audio quota (default 100 MiB)
USER_AUDIO_QUOTA_BYTES=104857600

# --- Firebase (client — Vite; safe to expose in browser) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin (server only — never commit) ---
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/firebase-adminsdk.json
# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=/absolute/path/firebase-adminsdk.json

# --- App JWT ---
JWT_ISSUER=syncwatch
JWT_AUDIENCE=syncwatch-clients
JWT_ACCESS_TTL_MIN=1440

# --- Server-side cached audio (yt-dlp) — OFF by default ---
SERVER_AUDIO_ENABLED=false
AUDIO_CACHE_DIR=
ROOM_IDLE_TTL_MS=1800000
AUDIO_CACHE_MAX_BYTES=
SERVER_AUDIO_SECRET=
YT_DLP_BIN=
YT_DLP_COOKIES=

# Legacy per-browser host imports (disk); logged-in hosts use MinIO + Postgres
HOST_PLAYLIST_MAX_BYTES=
HOST_MEDIA_DIR=
ROOM_COVERS_DIR=
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=/absolute/path/sa.json
