# Dependencies
node_modules/

# deploy
deploy/

# Build output (Vite)
dist/
dist-ssr/
build/

# TypeScript
*.tsbuildinfo

# Server-side audio cache (yt-dlp)
data/

# Environment & secrets — never commit real values
.env
.env.*
!.env.example

