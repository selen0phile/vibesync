firebaseConfig.js
firebase-adminsdk.json
firebase-adminsdk*.json
*-adminsdk*.json
service-account*.json
**/firebase-adminsdk*.json

# Cookies / keys
*cookies*.txt
*.pem
*.p12
# Vite cache
.vite/

# Logs & debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test / coverage
coverage/
.nyc_output/

# ESLint
.eslintcache

# Optional tooling
.turbo/
.vercel/

# OS junk
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln

# Editor / IDE
.idea/
*.sw?
.vscode/*
!.vscode/extensions.json

# Local-only overrides (often machine-specific)
*.local

# Cursor / agent workspace (large, machine-specific; keep rules in-repo only if you want)
.cursor/
